import os
import json
import requests
from datetime import datetime

# Configuration des APIs
SPORTS_CONFIG = {
    "football": {
        "url": "https://v3.football.api-sports.io/fixtures",
        "key_env": "API_FOOTBALL_KEY",
        "sport_name": "Football",
        "league_field": "league",
    },
    "rugby": {
        "url": "https://v1.rugby.api-sports.io/games",
        "key_env": "API_RUGBY_KEY",
        "sport_name": "Rugby",
        "league_field": "league",
    },
    "tennis": {
        "url": "https://v1.tennis.api-sports.io/matches",
        "key_env": "API_TENNIS_KEY",
        "sport_name": "Tennis",
        "league_field": "tournament",
    },
    "cycling": {
        "url": "https://v1.cycling.api-sports.io/races",
        "key_env": "API_CYCLING_KEY",
        "sport_name": "Cyclisme",
        "league_field": "race",
    },
}

def fetch_sport(sport_key, config, date_str):
    """Récupère les matchs d'un sport et retourne une liste de matchs avec TV."""
    api_key = os.environ.get(config["key_env"])
    if not api_key:
        print(f"  ⚠️  {config['sport_name']}: clé API manquante ({config['key_env']})")
        return []

    url = f"{config['url']}?date={date_str}"
    headers = {"x-apisports-key": api_key}

    try:
        response = requests.get(url, headers=headers, timeout=15)
        response.raise_for_status()
        data = response.json()

        if data.get("errors"):
            print(f"  ❌ {config['sport_name']}: Erreur API → {data['errors']}")
            return []

        items = data.get("response", [])
        print(f"  ✅ {config['sport_name']}: {len(items)} événements récupérés")

        matches_with_tv = []

        for item in items:
            # Structure différente selon le sport
            if sport_key == "football":
                tv_stations = item.get("tv", [])
                if not tv_stations:
                    continue
                home = item["teams"]["home"]["name"]
                away = item["teams"]["away"]["name"]
                league = item["league"]["name"]
                match_time = item["fixture"]["date"]
                status = item["fixture"]["status"]["short"]
                match_title = f"{home} – {away}"

            elif sport_key == "rugby":
                tv_stations = item.get("tv", [])
                if not tv_stations:
                    continue
                home = item["teams"]["home"]["name"]
                away = item["teams"]["away"]["name"]
                league = item["league"]["name"]
                match_time = item["game"]["date"]
                status = item["game"]["status"]["short"]
                match_title = f"{home} – {away}"

            elif sport_key == "tennis":
                tv_stations = item.get("tv", [])
                if not tv_stations:
                    continue
                player1 = item["players"][0]["name"]
                player2 = item["players"][1]["name"]
                league = item["tournament"]["name"]
                match_time = item["date"]
                status = item.get("status", {}).get("short", "NS")
                match_title = f"{player1} – {player2}"

            elif sport_key == "cycling":
                tv_stations = item.get("tv", [])
                if not tv_stations:
                    continue
                race_name = item["race"]["name"]
                league = item.get("country", {}).get("name", "International")
                match_time = item["date"]
                status = item.get("status", {}).get("short", "NS")
                match_title = race_name

            else:
                continue

            # Formater l'heure
            try:
                dt = datetime.fromisoformat(match_time.replace("Z", "+00:00"))
                time_str = dt.strftime("%H:%M")
            except Exception:
                time_str = "TBD"

            # Détecter le direct
            is_live = status in ["1H", "2H", "HT", "LIVE", "IP", "1P", "2P", "3P", "4P", "OT"]

            match_data = {
                "time": time_str,
                "sport": config["sport_name"],
                "competition": league,
                "match": match_title,
                "is_live": is_live,
            }

            # Ajouter à chaque chaîne TV
            for channel in tv_stations:
                channel_name = channel.strip()
                if channel_name:
                    matches_with_tv.append((channel_name, match_data))

        return matches_with_tv

    except Exception as e:
        print(f"  ❌ {config['sport_name']}: Erreur de requête → {e}")
        return []


def main():
    os.makedirs("data", exist_ok=True)

    today = datetime.now().strftime("%Y-%m-%d")
    tomorrow = (datetime.now() + timedelta(days=1)).strftime("%Y-%m-%d") if 'timedelta' in dir() else None
    
    # On récupère aujourd'hui ET demain pour avoir un programme complet
    dates_to_fetch = [today]
    try:
        from datetime import timedelta
        tomorrow = (datetime.now() + timedelta(days=1)).strftime("%Y-%m-%d")
        dates_to_fetch.append(tomorrow)
    except ImportError:
        pass

    print(f"🚀 Récupération du programme sportif pour : {', '.join(dates_to_fetch)}")
    print("=" * 60)

    schedule_by_channel = {}
    total_matches = 0

    for sport_key, config in SPORTS_CONFIG.items():
        print(f"\n📡 {config['sport_name']}...")
        for date_str in dates_to_fetch:
            matches = fetch_sport(sport_key, config, date_str)
            for channel_name, match_data in matches:
                if channel_name not in schedule_by_channel:
                    schedule_by_channel[channel_name] = []
                # Éviter les doublons
                if match_data not in schedule_by_channel[channel_name]:
                    schedule_by_channel[channel_name].append(match_data)
                    total_matches += 1

    # Trier les matchs par heure dans chaque chaîne
    for channel in schedule_by_channel:
        schedule_by_channel[channel].sort(key=lambda x: x["time"])

    # Sauvegarder
    output = {
        "updated_at": datetime.now().isoformat(),
        "sports_covered": [c["sport_name"] for c in SPORTS_CONFIG.values()],
        "total_matches": total_matches,
        "total_channels": len(schedule_by_channel),
        "channels": schedule_by_channel,
    }

    with open("data/schedule.json", "w", encoding="utf-8") as f:
        json.dump(output, f, indent=2, ensure_ascii=False)

    print("\n" + "=" * 60)
    print(f"✅ Terminé ! {total_matches} matchs sur {len(schedule_by_channel)} chaînes")
    print(f"📁 Fichier sauvegardé : data/schedule.json")


if __name__ == "__main__":
    main()
